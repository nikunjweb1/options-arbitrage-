# Copy this file to config/.env and fill in real values.
# NEVER commit config/.env -- it's in .gitignore, keep it that way.

# SCAN_ONLY | PAPER | LIVE  (LIVE is refused at startup regardless -- see settings.py)
APP_MODE=SCAN_ONLY

# Delta Exchange India -- get these from https://testnet.delta.exchange/ first,
# only move to production keys after the adapter is validated against testnet.
DELTA_USE_TESTNET=true
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here

# Risk limits (Phase 9 will enforce these; set real numbers before that phase)
MAX_TOTAL_CAPITAL=0
MAX_MARGIN_PER_TRADE=0
MAX_OPEN_TRADES=0
MAX_DAILY_LOSS=0
MIN_LIQUIDITY=0
MIN_EXPECTED_PROFIT=0

# Local SQLite path (Phase 2)
SQLITE_PATH=data/options_arb.db

# --- Phase 2 market-data collector (collectors/market_data_collector.py) ---
COLLECT_UNDERLYINGS=BTC
INSTRUMENT_REFRESH_INTERVAL_SEC=300
TICKER_POLL_INTERVAL_SEC=30
REQUEST_THROTTLE_SEC=0.05
MAX_INSTRUMENTS_PER_UNDERLYING=0
COLLECTOR_MAX_RETRIES=3
COLLECTOR_RETRY_BACKOFF_SEC=1.0
COLLECTOR_LOG_PATH=logs/collector.log

# --- Integration tests (tests/test_delta_integration.py) ---
# Never set this to true in CI or against production credentials.
RUN_INTEGRATION_TESTS=false

# --- Shark Exchange WS (exchange_adapters/shark_ws.py) ---
# OPTIONAL. Leave blank/unset unless the polling+Origin-header fix alone
# still isn't enough (connects then disconnects almost immediately -- see
# shark_ws.py's CONNECTION FIX HISTORY). If so, capture the real Cookie
# header sent on the WS handshake via Chrome DevTools (Network -> WS ->
# click the fawss-options.sharkexchange.in row -> Headers tab -> Request
# Headers -> Cookie), paste the FULL value here, and never anywhere else
# (not in code, not in chat, not in a commit -- this file is gitignored).
SHARK_WS_COOKIE=

# --- Telegram notifications (notifications/telegram_notifier.py) ---
# OPTIONAL, but needed for pricing/manual_spread_finder.py's phone alerts.
# Setup (~3 minutes, no coding): message @BotFather in Telegram -> /newbot
# -> follow prompts -> it gives you a token for TELEGRAM_BOT_TOKEN. Then
# message your new bot anything, visit
# https://api.telegram.org/bot<TOKEN>/getUpdates in a browser, and find
# "chat":{"id": ...} in the response -- that number is TELEGRAM_CHAT_ID.
# Leave both blank to skip notifications (the dashboard still works fine).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
