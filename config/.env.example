# Copy this file to config/.env and fill in real values.
# NEVER commit config/.env -- it's in .gitignore, keep it that way.

# SCAN_ONLY | PAPER | LIVE  (LIVE is refused at startup regardless -- see settings.py)
APP_MODE=SCAN_ONLY

# Delta Exchange India -- get these from https://testnet.delta.exchange/ first,
# only move to production keys after the adapter is validated against testnet.
DELTA_USE_TESTNET=true
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here

# Risk limits (Phase 9 will enforce these; set real numbers before that phase)
MAX_TOTAL_CAPITAL=0
MAX_MARGIN_PER_TRADE=0
MAX_OPEN_TRADES=0
MAX_DAILY_LOSS=0
MIN_LIQUIDITY=0
MIN_EXPECTED_PROFIT=0

# Local SQLite path (Phase 2)
SQLITE_PATH=data/options_arb.db
